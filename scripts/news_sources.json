  "actionablePatterns": [
    "CVE-\\d{4}-\\d{4,}",
    "GHSA-[a-z0-9-]+",
    "critical severity|important severity|high severity|severity: (?:critical|important|high)",
    "affected versions?|impacted versions?|fixed versions?|patched versions?",
    "security advisory|security bulletin|vulnerabilit",
    "permission|policy|trust polic|condition key|service-linked role",
    "finding type|security control|detection rule|telemetry|logging|audit log",
    "authentication|authorization|encryption|cross-account|public access",
    "deprecat|end.of.life|workaround|mitigat|remediat"
